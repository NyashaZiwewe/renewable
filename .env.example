# PHP API MySQL/MariaDB connection. Most API stores can use JSON files if omitted;
# whistleblowing reports and conversations require MySQL/MariaDB.
# Public site base URL, used to build browser API requests (for example https://example.com/renewable).
BASE_URL=https://example.com/renewable
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=renewable
DB_USER=renewable_user
DB_PASSWORD=

# Email delivery uses Resend. Set a valid API key and sender address to deliver reporter token emails.
# The reporter must enter an email address for the token email to be sent.
# RESEND_API_KEY=re_xxxxxxxxx
# LEAD_EMAIL_FROM="Mozambique Renewable Energy Venture <no-reply@example.com>"
# Optional verified sender for admin reset emails. Falls back to LEAD_EMAIL_FROM.
# RESET_EMAIL_FROM="Mozambique Renewable Energy Venture <no-reply@example.com>"
# Set to mail to use the hosting server's PHP mail() transport for admin resets.
# With mail, set RESET_EMAIL_FROM to a bare mailbox address, such as support@example.com.
# RESET_MAIL_TRANSPORT=resend
# Optional recipient for new whistleblowing reports and reporter follow-ups; otherwise Admin > Queries recipient is used.
# WHISTLEBLOWING_EMAIL=reports@example.com
# Query notifications use the recipient configured in Admin > Queries.
# Optional initial recipient; can be changed from Admin > Queries.
# LEAD_NOTIFICATION_EMAIL=queries@example.com
